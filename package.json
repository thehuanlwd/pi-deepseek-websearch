{
  "name": "pi-deepseek-websearch",
  "version": "0.1.0",
  "description": "Native web search and page fetch tools for pi, powered by the DeepSeek Search API, with OS-encrypted API key storage.",
  "type": "module",
  "license": "MIT",
  "author": "thehuan",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "web-search",
    "web-fetch",
    "deepseek",
    "search",
    "fetch",
    "agent-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
